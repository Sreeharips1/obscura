# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Set to 1 only while developing. Debug output can contain private values.
OBSCURA_DEBUG=0

# Comma-separated list of origins allowed to call the API from a browser.
OBSCURA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set this on any public deployment. The site asks for it before it works.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
OBSCURA_ACCESS_KEY=
